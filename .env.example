# Neon Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/neondb?sslmode=require"
# Sign-up is invite-only. Share this code with your students.
INVITE_CODE="change-me"
# This email becomes the teacher account (sees every student's progress).
TEACHER_EMAIL="you@example.com"
